# Image for running the P2 tests (Home Assistant test harness) without
# installing anything on the developer's machine. See docs/testing-strategy.md.
#
# The Python version is dictated by Home Assistant: 2026.9 requires >= 3.14.2.
FROM python:3.14-slim

WORKDIR /workspace

COPY requirements-test-ha.txt .
RUN pip install --no-cache-dir -r requirements-test-ha.txt

CMD ["pytest", "tests", "-v", "--asyncio-mode=auto"]
