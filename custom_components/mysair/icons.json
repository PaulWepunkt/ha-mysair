{
  "entity": {
    "binary_sensor": {
      "installation_active": {
        "default": "mdi:hvac",
        "state": {
          "off": "mdi:hvac-off"
        }
      },
      "direction_conflict": {
        "default": "mdi:alert-outline",
        "state": {
          "off": "mdi:check-circle-outline"
        }
      }
    },
    "sensor": {
      "cloud_connection": {
        "default": "mdi:cloud-check",
        "state": {
          "offline": "mdi:cloud-off-outline"
        }
      },
      "target_temperature": {
        "default": "mdi:thermostat"
      },
      "mode": {
        "default": "mdi:hvac",
        "state": {
          "off": "mdi:hvac-off",
          "heat": "mdi:fire",
          "cool": "mdi:snowflake"
        }
      },
      "operating_mode": {
        "default": "mdi:sun-snowflake-variant",
        "state": {
          "heat": "mdi:fire",
          "cool": "mdi:snowflake"
        }
      },
      "main_zone": {
        "default": "mdi:home-thermometer-outline"
      }
    },
    "switch": {
      "power": {
        "default": "mdi:power"
      },
      "floor_heating": {
        "default": "mdi:heat-wave"
      }
    }
  },
  "services": {
    "stop_installation": {
      "service": "mdi:stop-circle-outline"
    }
  }
}
