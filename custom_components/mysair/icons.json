{
  "entity": {
    "binary_sensor": {
      "installation_active": {
        "default": "mdi:hvac",
        "state": {
          "off": "mdi:hvac-off"
        }
      },
      "direction_conflict": {
        "default": "mdi:alert-outline",
        "state": {
          "off": "mdi:check-circle-outline"
        }
      },
      "direction_mismatch": {
        "default": "mdi:alert",
        "state": {
          "off": "mdi:check-circle-outline"
        }
      }
    },
    "button": {
      "stop_installation": {
        "default": "mdi:stop-circle-outline"
      }
    },
    "climate": {
      "thermostat": {
        "default": "mdi:thermostat",
        "state_attributes": {
          "fan_mode": {
            "default": "mdi:fan",
            "state": {
              "zonal": "mdi:fan-auto",
              "1": "mdi:fan-speed-1",
              "2": "mdi:fan-speed-2",
              "3": "mdi:fan-speed-3",
              "auto": "mdi:fan-auto"
            }
          }
        }
      }
    },
    "select": {
      "operating_mode": {
        "default": "mdi:sun-snowflake-variant",
        "state": {
          "heat": "mdi:fire",
          "cool": "mdi:snowflake"
        }
      },
      "heating_medium": {
        "default": "mdi:radiator",
        "state": {
          "air": "mdi:fan",
          "floor": "mdi:heat-wave",
          "air_and_floor": "mdi:home-thermometer"
        }
      },
      "cooling_medium": {
        "default": "mdi:snowflake-thermometer",
        "state": {
          "air": "mdi:fan",
          "floor": "mdi:heat-wave",
          "air_and_floor": "mdi:home-thermometer"
        }
      }
    },
    "sensor": {
      "cloud_connection": {
        "default": "mdi:cloud-check",
        "state": {
          "offline": "mdi:cloud-off-outline"
        }
      },
      "target_temperature": {
        "default": "mdi:thermostat"
      },
      "mode": {
        "default": "mdi:hvac",
        "state": {
          "off": "mdi:hvac-off",
          "heat": "mdi:fire",
          "cool": "mdi:snowflake"
        }
      },
      "main_zone": {
        "default": "mdi:home-thermometer-outline"
      }
    },
    "switch": {
      "power": {
        "default": "mdi:power"
      },
      "floor_heating": {
        "default": "mdi:heat-wave"
      },
      "mysair_switches_heat_pump": {
        "default": "mdi:link-variant",
        "state": {
          "off": "mdi:link-variant-off"
        }
      }
    }
  },
  "services": {
    "stop_installation": {
      "service": "mdi:stop-circle-outline"
    }
  }
}
